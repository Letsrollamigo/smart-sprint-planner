#!/bin/sh
# Быстрый architecture-gate перед КАЖДЫМ коммитом (~2с, без golden).
# Механический гейт без remote выполняется на pre-commit.
# Версионируется в дереве (tools/hooks/), ставится tools/install-hooks.sh.
# Обход осознанный: git commit --no-verify (но release-check.sh всё равно поймает).
set -e
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
echo "[pre-commit] architecture gate: arch + unit…"
node --test tests/arch/*.test.js tests/unit/*.test.js
echo "[pre-commit] ✅ зелёно (golden гоняется на push/release)"
