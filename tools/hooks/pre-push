#!/bin/sh
# Полный gate перед push (для форка с remote — community).
# Версионируется в дереве (tools/hooks/), ставится tools/install-hooks.sh.
set -e
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
echo "[pre-push] full gate: arch + mirror + unit + golden…"
TZ=UTC node --test tests/arch/*.test.js tests/mirror/*.test.js tests/unit/*.test.js tests/golden/*.test.js
echo "[pre-push] ✅ зелёно"
