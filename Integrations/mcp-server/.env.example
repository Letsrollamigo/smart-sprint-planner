# Адрес YouTrack, к которому ходит сервер (изнутри контейнера localhost хоста — host.docker.internal)
YT_BASE_URL=http://host.docker.internal:8080
# Имя приложения планера в адресе контракта — по умолчанию из сборки, менять не нужно
# PLANNER_APP_ID=
# Защита от DNS-rebinding: хосты, под которыми клиенты обращаются к серверу
MCP_ALLOWED_HOSTS=localhost:8085,127.0.0.1:8085
# Язык описаний инструментов и текстов (из перечня сборки)
MCP_LANG=ru
# Только чтение: 1 — инструментов записи нет
READ_ONLY=0
# Разрешённые проекты через запятую; пусто — все
PROJECT_ALLOWLIST=
LOG_LEVEL=info
