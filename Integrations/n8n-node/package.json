{
	"name": "n8n-nodes-smart-sprint-planner",
	"version": "0.1.1",
	"description": "n8n node for Smart Sprint Planner: the working sprint and role items, history, capacity, absences, releases and permissions through the YouTrack external REST",
	"license": "MIT",
	"homepage": "https://github.com/Letsrollamigo/smart-sprint-planner/tree/main/Integrations/n8n-node#readme",
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "Letsrollamigo",
		"email": "Oberon999@yandex.kz"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Letsrollamigo/smart-sprint-planner.git",
		"directory": "Integrations/n8n-node"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"test": "n8n-node build && TZ=UTC node --test tests/*.test.mjs",
		"sync-shared": "node scripts/sync-shared.mjs",
		"check-shared": "node scripts/sync-shared.mjs --check",
		"smoke": "node tests/smoke-n8n.mjs"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/SmartSprintPlannerApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/SprintPlanner/SprintPlanner.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.49.1",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
