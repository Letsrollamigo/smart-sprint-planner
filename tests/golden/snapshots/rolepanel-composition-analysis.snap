          "html": "<select class=\"inc-sel\" data-iid=\"GM-1\" data-rk=\"analysis\"><option value=\"INC_PENDING\">Ожидает распределения</option><option value=\"INC_PLANNED\" selected>Включена планово</option><option value=\"INC_UNPLANNED\">Включена внепланово</option><option value=\"INC_EXCLUDED\">Исключена из спринта</option></select>"
